<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.qoder.oppoemu"
    android:versionCode="65"
    android:versionName="6.5">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:description="@string/desc"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false">

        <activity
            android:name=".StatusActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- legacy Xposed/LSPosed 识别：ModuleUtil.isLegacyModule 只看 xposedminversion 这个 key -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.qoder.oppoemu.config"
            android:exported="true" />

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposeddescription" android:value="@string/desc" />
        <meta-data android:name="xposedscope" android:resource="@array/scope" />
    </application>
</manifest>
